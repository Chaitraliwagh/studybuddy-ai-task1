# Copy this file to ".env" (same folder) and edit if needed.
# The defaults below work for a normal local Ollama install.

# Where Ollama is running
OLLAMA_BASE_URL=http://localhost:11434

# Which Gemma model to use. Must already be downloaded: ollama pull gemma3:4b
OLLAMA_MODEL=gemma3:4b

# How long to wait for the model (seconds). Slow laptops may need more.
OLLAMA_TIMEOUT_SECONDS=180

# Context window sent to the model (tokens). Lower it if you run out of RAM.
OLLAMA_NUM_CTX=8192

# Which website addresses may call this backend (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Longest notes text accepted (characters)
MAX_NOTES_CHARS=12000
